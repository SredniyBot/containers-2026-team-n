# Переменные для docker-compose.yml.
# Учебные значения. В рабочем проекте .env не коммитят:
# в репозиторий кладут .env.example без секретов.

# Порт на хосте, по которому открывается приложение
APP_PORT=8080

# PostgreSQL: читает сам образ postgres и приложение
POSTGRES_DB=notes
POSTGRES_USER=notes
POSTGRES_PASSWORD=notes-lab2-password

# Приложение
STORAGE=postgres
DB_HOST=db
DB_PORT=5432
MIGRATE_TIMEOUT=60
